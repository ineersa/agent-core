{
    "name": "ineersa/agent-core-dev",
    "type": "project",
    "license": "MIT",
    "description": "Monorepo for the agent-core ecosystem, consolidated into a single modular monolith.",
    "suggest": {
        "ineersa/hatfield-ext-file-rewind": "File Rewind",
        "ineersa/hatfield-ext-task-workflow": "Task Workflow",
        "ineersa/hatfield-ext-observational-memory": "Observational Memory"
    },
    "repositories": [
        {
            "type": "vcs",
            "url": "https://github.com/ineersa/amp-sqlite3"
        },
        {
            "type": "vcs",
            "url": "https://github.com/ineersa/sqlite-queue"
        },
        {
            "type": "git",
            "url": "https://github.com/ineersa/symfony-ai-openai-chatgpt-platform.git"
        },
        {
            "type": "path",
            "url": ".hatfield/extensions/extension-api",
            "options": {
                "symlink": true
            }
        }
    ],
    "require": {
        "php": ">=8.5",
        "ext-ctype": "*",
        "ext-curl": "*",
        "ext-fileinfo": "*",
        "ext-filter": "*",
        "ext-iconv": "*",
        "ext-intl": "*",
        "ext-mbstring": "*",
        "ext-openssl": "*",
        "ext-pcntl": "*",
        "ext-pdo_sqlite": "*",
        "ext-sqlite3": "*",
        "ext-phar": "*",
        "ext-posix": "*",
        "ext-tokenizer": "*",
        "ext-xml": "*",
        "ext-zstd": "*",
        "ineersa/hatfield-extension-api": "@dev",
        "symfony/console": "8.2.*@dev",
        "symfony/dependency-injection": "8.2.*@dev",
        "symfony/config": "8.2.*@dev",
        "symfony/event-dispatcher": "8.2.*@dev",
        "symfony/messenger": "8.2.*@dev",
        "symfony/dotenv": "8.2.*@dev",
        "symfony/yaml": "8.2.*@dev",
        "doctrine/dbal": "^4.3",
        "doctrine/migrations": "^3.8",
        "symfony/lock": "8.2.*@dev",
        "helgesverre/toon": "^3.1",
        "symfony/ai-agent": "^1.0@beta",
        "symfony/ai-platform": "^1.0@beta",
        "symfony/validator": "8.2.*@dev",
        "symfony/uid": "8.2.*@dev",
        "symfony/tui": "8.2.x-dev",
        "symfony/ai-generic-platform": "^1.0@beta",
        "symfony/ai-open-responses-platform": "^1.0@beta",
        "monolog/monolog": "^3.10",
        "symfony/framework-bundle": "8.2.*@dev",
        "symfony/monolog-bundle": "^4.0",
        "doctrine/doctrine-bundle": "^3.2",
        "league/mime-type-detection": "^1.15",
        "symfony/expression-language": "8.2.*@dev",
        "doctrine/orm": "^3.6",
        "symfony/var-exporter": "8.2.*@dev",
        "doctrine/doctrine-migrations-bundle": "^4.0",
        "symfony/process": "8.2.*@dev",
        "league/oauth2-client": "^2.8",
        "symfony/scheduler": "8.2.*@dev",
        "mcp/sdk": "dev-main",
        "amphp/http-client": "^5.3",
        "league/commonmark": "^2.8",
        "tempest/highlight": "^2.27",
        "symfony/ai-store": "^1.0@beta",
        "symfony/ai-sqlite-store": "^1.0@beta",
        "symfony/ai-vektor-store": "^1.0@beta",
        "centamiv/vektor": "^2.0",
        "ineersa/symfony-ai-openai-chatgpt-platform": "0.2.2",
        "ineersa/sqlite-queue": "dev-main#a19d6e7684772be355f8db961cb2200e21ed5cd9",
        "fabpot/amphp-sqlite3": "dev-development#2cf3d23e6a4645133954052d7356c19c30a2a7d8",
        "amphp/http-tunnel": "^2.0"
    },
    "require-dev": {
        "friendsofphp/php-cs-fixer": "^3.94",
        "phpstan/phpstan": "^2.1",
        "phpstan/phpstan-phpunit": "^2.0",
        "phpstan/phpstan-strict-rules": "^2.0",
        "phpunit/phpunit": "^13.2",
        "deptrac/deptrac": "^4.6",
        "dama/doctrine-test-bundle": "^8.6",
        "brianium/paratest": "^7.23",
        "shipmonk/dead-code-detector": "^1.4"
    },
    "autoload": {
        "psr-4": {
            "Ineersa\\AgentCore\\": "src/AgentCore/",
            "Ineersa\\CodingAgent\\": "src/CodingAgent/",
            "Ineersa\\Tui\\": "src/Tui/",
            "DoctrineMigrations\\": "migrations/application/",
            "Ineersa\\Platform\\": "src/Platform/",
            "Ineersa\\HatfieldExt\\TaskWorkflow\\": ".hatfield/extensions/task-workflow/src/",
            "Ineersa\\HatfieldExt\\FileRewind\\": ".hatfield/extensions/file-rewind/src/",
            "Ineersa\\HatfieldExt\\ObservationalMemory\\": ".hatfield/extensions/observational-memory/src/"
        },
        "classmap": [
            "src/CodingAgent/Logging/SessionResourceSamplerTask.php"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "Ineersa\\CodingAgent\\Tests\\": "tests/CodingAgent/",
            "Ineersa\\AgentCore\\Tests\\": "tests/AgentCore/",
            "Ineersa\\Tui\\Tests\\": "tests/Tui/",
            "Ineersa\\Platform\\Tests\\": "tests/Platform/",
            "Ineersa\\HatfieldExt\\TaskWorkflow\\Tests\\": ".hatfield/extensions/task-workflow/tests/",
            "Ineersa\\HatfieldExt\\FileRewind\\Tests\\": ".hatfield/extensions/file-rewind/tests/",
            "Ineersa\\HatfieldExt\\ObservationalMemory\\Tests\\": ".hatfield/extensions/observational-memory/tests/",
            "Ineersa\\Tools\\PHPStan\\": "tools/phpstan/"
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "config": {
        "allow-plugins": {
            "php-http/discovery": true
        }
    }
}
