{
    "name": "ineersa/hatfield-ext-observational-memory",
    "description": "Observational memory extension for Hatfield (OM SQLite storage + async Observer pipeline)",
    "type": "hatfield-extension",
    "license": "MIT",
    "require": {
        "php": ">=8.5",
        "ext-mbstring": "*",
        "ext-pdo_sqlite": "*",
        "centamiv/vektor": "2.0.2",
        "doctrine/dbal": "^4.3",
        "helgesverre/toon": "^3.1",
        "ineersa/hatfield-extension-api": "@dev",
        "psr/log": "^3.0",
        "symfony/ai-generic-platform": "^0.13",
        "symfony/ai-platform": "^0.13",
        "symfony/ai-sqlite-store": "^0.13",
        "symfony/ai-store": "^0.13",
        "symfony/ai-vektor-store": "^0.13",
        "symfony/clock": "^8.0",
        "symfony/filesystem": "^8.0",
        "symfony/http-client": "^8.0",
        "symfony/lock": "^8.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^12.0"
    },
    "autoload": {
        "psr-4": {
            "Ineersa\\HatfieldExt\\ObservationalMemory\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Ineersa\\HatfieldExt\\ObservationalMemory\\Tests\\": "tests/"
        }
    },
    "config": {
        "sort-packages": true
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
