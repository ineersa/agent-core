{
    "name": "ineersa/hatfield-ext-observational-memory",
    "description": "Thin client for Librarian-owned observational memory",
    "type": "hatfield-extension",
    "license": "MIT",
    "extra": {
        "hatfield": {
            "extension": "Ineersa\\HatfieldExt\\ObservationalMemory\\ObservationalMemoryExtension"
        }
    },
    "require": {
        "ext-curl": "*",
        "guzzlehttp/psr7": "^3.2",
        "helgesverre/toon": "^3.1",
        "ineersa/hatfield-extension-api": "@dev",
        "mcp/sdk": "^0.9",
        "php": ">=8.5",
        "psr/log": "^3.0",
        "symfony/config": "^8.1",
        "symfony/filesystem": "^8.0",
        "symfony/http-client": "^8.0",
        "symfony/process": "^8.0",
        "symfony/property-access": "^8.0",
        "symfony/property-info": "^8.0",
        "symfony/serializer": "^8.0",
        "symfony/validator": "^8.0",
        "symfony/yaml": "^8.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^12.0"
    },
    "autoload": {
        "psr-4": {
            "Ineersa\\HatfieldExt\\ObservationalMemory\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Ineersa\\HatfieldExt\\ObservationalMemory\\Tests\\": "tests/"
        }
    },
    "config": {
        "sort-packages": true
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
