{
    "name": "ineersa/hatfield-ext-jbcontext",
    "description": "JetBrains Context (jbcontext) semantic-search extension for Hatfield",
    "type": "hatfield-extension",
    "license": "MIT",
    "require": {
        "php": ">=8.3",
        "helgesverre/toon": "^3.1",
        "ineersa/hatfield-extension-api": "@dev",
        "psr/log": "^3.0"
    },
    "autoload": {
        "psr-4": {
            "Ineersa\\HatfieldExt\\Jbcontext\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Ineersa\\HatfieldExt\\Jbcontext\\Tests\\": "tests/"
        }
    },
    "config": {
        "sort-packages": true
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
