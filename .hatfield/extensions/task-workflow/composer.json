{
    "name": "ineersa/hatfield-ext-task-workflow",
    "description": "Task workflow extension for Hatfield (native port of pi task-workflow).",
    "type": "hatfield-extension",
    "license": "MIT",
    "require": {
        "php": ">=8.3",
        "helgesverre/toon": "^3.1",
        "ineersa/hatfield-extension-api": "@dev",
        "psr/log": "^3.0",
        "symfony/filesystem": "^7.3|^8.0",
        "symfony/yaml": "^7.3|^8.0"
    },
    "autoload": {
        "psr-4": {
            "Ineersa\\HatfieldExt\\TaskWorkflow\\": "src/"
        }
