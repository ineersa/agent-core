#!/usr/bin/env php
<?php

declare(strict_types=1);

use Ineersa\HatfieldExt\Hatfield360\ReportCommand;
use Symfony\Component\Console\Application;

$autoload = $_composer_autoload_path ?? dirname(__DIR__).'/vendor/autoload.php';
if (!is_file($autoload)) {
    if (in_array('--claude-hook', $argv, true)) {
        // Match HookDiagnostic's stderr format without relying on autoloading.
        fwrite(\STDERR, '{"component":"hatfield_360","event_type":"hook_dependencies_missing","action":"Ensure the active Claude plugin has its Composer runtime dependencies, then reload the plugin or restart Claude Code."}'."\n");
        exit(0);
    }

    exit(1);
}
require $autoload;

$application = new Application('h360-report');
$application->addCommand(new ReportCommand());
$application->setDefaultCommand('report', true);
$application->run();
