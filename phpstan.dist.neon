includes:
    - vendor/phpstan/phpstan-strict-rules/rules.neon
    - vendor/phpstan/phpstan-phpunit/extension.neon

parameters:
    level: 6
    ignoreErrors:
        # Native deserialization initializes a fresh instance via the parent constructor.
        -
            message: '#^Static call to __construct\(\) is only allowed on a parent class in the constructor\.$#'
            identifier: constructor.call
            path: src/AgentCore/Domain/Message/ApplyCommand.php
            count: 1
    treatPhpDocTypesAsCertain: false
    paths:
        - src/
        - tools/phpstan/
        - castor.php
        - .castor/
        - .hatfield/extensions/
    scanFiles:
        - .castor.stub.php
        - .castor/helpers.php
        - .castor/qa_tmux.php
    stubFiles:
        - phpstan/stubs/league-oauth2-client.stub
    tmpDir: var/phpstan
    excludePaths:
        - .castor/vendor/*
        - var/*
        - vendor/*
        - .hatfield/extensions/vendor/*
        - .hatfield/extensions/task-workflow/tests/*
        - .hatfield/extensions/observational-memory/tests/*
    parallel:
        maximumNumberOfProcesses: 1
