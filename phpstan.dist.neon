includes:
    - vendor/phpstan/phpstan-strict-rules/rules.neon
    - vendor/phpstan/phpstan-phpunit/extension.neon
    - phpstan-baseline.neon

rules:
    - Ineersa\Tools\PHPStan\Rules\NoSilentCatchRule

services:
    -
        class: Ineersa\Tools\PHPStan\Rules\NoNullableCollaboratorRule
        arguments:
            sourceDirectory: %currentWorkingDirectory%/src
        tags:
            - phpstan.rules.rule

parameters:
    level: 6
    treatPhpDocTypesAsCertain: false
    # Keep unmatched reporting on so the baseline shrinks as violations are fixed.
    reportUnmatchedIgnoredErrors: true
    paths:
        - src/
        - tools/phpstan/
        - castor.php
        - .castor/
        - .hatfield/extensions/
    scanFiles:
        - .castor.stub.php
        - .castor/helpers.php
        - .castor/qa_tmux.php
    stubFiles:
        - phpstan/stubs/league-oauth2-client.stub
    tmpDir: var/phpstan
    excludePaths:
        - .castor/vendor/*
        - var/*
        - vendor/*
        - .hatfield/extensions/vendor/*
        - .hatfield/extensions/task-workflow/tests/*
        - .hatfield/extensions/observational-memory/tests/*
    parallel:
        maximumNumberOfProcesses: 1
    ignoreErrors:
        # Castor tasks are dev tooling without a PSR logger; console output is their
        # failure channel, so the silent-catch rule targets production code only.
        -
            identifier: hatfield.silentCatch
            path: .castor/*
            reportUnmatched: false
