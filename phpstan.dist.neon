includes:
    - phpstan-baseline.neon
    - vendor/phpstan/phpstan-strict-rules/rules.neon
    - vendor/phpstan/phpstan-phpunit/extension.neon

parameters:
    level: 6
    treatPhpDocTypesAsCertain: false
    paths:
        - src/
        - tools/phpstan/
        - castor.php
        - .castor/
        - .hatfield/extensions/
    scanFiles:
        - .castor.stub.php
        - .castor/helpers.php
        - .castor/qa_tmux.php
    tmpDir: var/phpstan
    excludePaths:
        - .castor/vendor/*
        - var/*
        - vendor/*
        - .hatfield/extensions/vendor/*
        - .hatfield/extensions/task-workflow/tests/*
        - .hatfield/extensions/castor-llm-mode/tests/*
        - .hatfield/extensions/file-rewind/tests/*
        - .hatfield/extensions/observational-memory/tests/*
    # Keep these in config (not inline) so the dead-code lane never sees
    # unmatched main-lane suppressions under customRulesetUsed=true.
    ignoreErrors:
        -
            identifier: nullsafe.neverNull
            path: src/Tui/Listener/SubmitListener.php
        -
            identifier: if.alwaysFalse
            path: src/Tui/Listener/PromptHistoryListener.php
    parallel:
        maximumNumberOfProcesses: 1
