{
    "directories": [
        "bin",
        "src",
        "config",
        "docs",
        ".hatfield/extensions/extension-api",
        "migrations"
    ],
    "files": [
        "bin/console",
        "composer.json",
        "composer.lock"
    ],
    "output": "var/tmp/phar/hatfield.phar",
    "compression": "GZ",
    "algorithm": "SHA256",
    "main": "bin/console",
    "dump-autoload": false,
    "check-requirements": false,
    "exclude-composer-files": false,
    "exclude-dev-files": true,
    "annotations": false,
    "finder": [
        {
            "in": "vendor",
            "notPath": [
                "ineersa/symfony-ai-openai-chatgpt-platform/vendor",
                "ineersa/symfony-ai-openai-chatgpt-platform/tests",
                "ineersa/symfony-ai-openai-chatgpt-platform/.git",
                "ineersa/symfony-ai-openai-chatgpt-platform/var",
                "ineersa/symfony-ai-openai-chatgpt-platform/.phpunit.cache"
            ]
        }
    ]
}
