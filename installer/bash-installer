#!/usr/bin/env bash
# Hatfield bash installer: downloads a release PHAR or static binary, verifies
# SHA-256 against the published SHA256SUMS file, smokes the candidate, then
# installs atomically. Failures leave any previous install untouched and leave
# no temp residue.
set -euo pipefail

HATFIELD_NAME="Hatfield"
HATFIELD_EXECUTABLE="hatfield"
HATFIELD_OWNED_PHP_CLI="hatfield-php"
GITHUB_REPO="${HATFIELD_GITHUB_REPO:-ineersa/agent-core}"
DOWNLOAD_BASE="${HATFIELD_DOWNLOAD_BASE:-https://github.com/${GITHUB_REPO}/releases}"
# Optional test/mirror seam: when set, asset downloads use this base
# instead of GitHub (also useful for private mirrors).
# Example: HATFIELD_INSTALLER_BASE_URL=http://127.0.0.1:8765
INSTALLER_BASE_URL="${HATFIELD_INSTALLER_BASE_URL:-}"

# Keep synchronized with composer.json ext-*, bin/console PHAR guard,
# tools/static/pin.json, and docs/phar-packaging.md.
REQUIRED_PHP_VERSION="8.5"
REQUIRED_EXTENSIONS=(pdo_sqlite sqlite3 mbstring xml intl curl openssl pcntl posix tokenizer ctype fileinfo filter iconv phar zstd)

install_dir="${HOME}/.local/bin"
version="latest"
static="false"

# Track every temp path so traps can remove install-dir temporary destinations
# as well as the mktemp download workspace.
TMPDIR_INSTALL=""
INSTALL_TMP=""
INSTALL_CLI_TMP=""
INSTALL_PAIR_DIR=""
INSTALL_APP_BAK=""
INSTALL_CLI_BAK=""

output() {
  local style_start="" style_end=""
  if [[ "${2:-}" != "" ]]; then
    case "$2" in
      success) style_start="\033[0;32m"; style_end="\033[0m" ;;
      error) style_start="\033[31;31m"; style_end="\033[0m" ;;
      heading) style_start="\033[1;33m"; style_end="\033[22;39m" ;;
    esac
  fi
  # shellcheck disable=SC2059
  printf "%b\n" "${style_start}${1}${style_end}"
}

cleanup() {
  local exit_code=$?
  if [[ -n "${INSTALL_TMP}" && -e "${INSTALL_TMP}" ]]; then
    rm -f "${INSTALL_TMP}" 2>/dev/null || true
  fi
  if [[ -n "${INSTALL_CLI_TMP}" && -e "${INSTALL_CLI_TMP}" ]]; then
    rm -f "${INSTALL_CLI_TMP}" 2>/dev/null || true
  fi
  if [[ -n "${INSTALL_PAIR_DIR}" && -d "${INSTALL_PAIR_DIR}" ]]; then
    rm -rf "${INSTALL_PAIR_DIR}" 2>/dev/null || true
  fi
  # Restore previous matched pair if activation failed mid-swap.
  if [[ -n "${INSTALL_APP_BAK}" && -e "${INSTALL_APP_BAK}" ]]; then
    mv -f "${INSTALL_APP_BAK}" "${install_dir}/${HATFIELD_EXECUTABLE}" 2>/dev/null || true
  fi
  if [[ -n "${INSTALL_CLI_BAK}" && -e "${INSTALL_CLI_BAK}" ]]; then
    mv -f "${INSTALL_CLI_BAK}" "${install_dir}/${HATFIELD_OWNED_PHP_CLI}" 2>/dev/null || true
  fi
  if [[ -n "${TMPDIR_INSTALL}" && -d "${TMPDIR_INSTALL}" ]]; then
    rm -rf "${TMPDIR_INSTALL}" 2>/dev/null || true
  fi
  return "${exit_code}"
}
trap cleanup EXIT INT TERM

usage() {
  cat <<EOF
Usage: $0 [--install-dir=DIR] [--version=VERSION|latest] [--static]

Options:
  --install-dir=DIR   Install directory (default: ~/.local/bin)
  --version=VERSION   latest or safe semver tag (optional v, major.minor.patch, optional -prerelease/+build)
  --static            Install fused native binary instead of PHAR
  -h, --help          Show this help

Environment:
  HATFIELD_GITHUB_REPO, HATFIELD_DOWNLOAD_BASE, HATFIELD_INSTALLER_BASE_URL
EOF
}

require_opt_value() {
  local flag="$1"
  local value="${2:-}"
  if [[ -z "${value}" || "${value}" == --* ]]; then
    output "ERROR: ${flag} requires a non-empty value" "error"
    usage
    exit 1
  fi
}

while [[ $# -gt 0 ]]; do
  case "$1" in
    --install-dir=*)
      install_dir="${1#*=}"
      require_opt_value "--install-dir" "${install_dir}"
      shift
      ;;
    --install-dir)
      require_opt_value "--install-dir" "${2:-}"
      install_dir="$2"
      shift 2
      ;;
    --version=*)
      version="${1#*=}"
      require_opt_value "--version" "${version}"
      shift
      ;;
    --version)
      require_opt_value "--version" "${2:-}"
      version="$2"
      shift 2
      ;;
    --static) static="true"; shift ;;
    -h|--help) usage; exit 0 ;;
    *) output "Unknown option $1" "error"; usage; exit 1 ;;
  esac
done

# Fail closed before any temp/download work: only "latest" or safe release tags.
# Optional leading v + major.minor.patch + optional prerelease/build using [0-9A-Za-z.-].
# Rejects path traversal, whitespace, query/fragment, and other unsafe URL path chars.
if [[ "${version}" != "latest" ]]; then
  if ! [[ "${version}" =~ ^v?[0-9]+\.[0-9]+\.[0-9]+([+-][0-9A-Za-z.-]+)?$ ]]; then
    output "ERROR: invalid --version '${version}' (use 'latest' or a semver release tag like v1.2.3)" "error"
    exit 1
  fi
fi

TMPDIR_INSTALL="$(mktemp -d "${TMPDIR:-/tmp}/hatfield-install.XXXXXX")"

output "${HATFIELD_NAME} installer" "heading"
output "\nEnvironment check" "heading"

downloader=""
if command -v curl >/dev/null 2>&1; then
  downloader="curl"
  output "  [*] cURL is installed" "success"
elif command -v wget >/dev/null 2>&1; then
  downloader="wget"
  output "  [*] wget is installed" "success"
else
  output "  [ ] ERROR: cURL or wget is required" "error"
  exit 1
fi

if [[ "${static}" == "false" ]]; then
  if ! command -v php >/dev/null 2>&1; then
    output "  [ ] ERROR: PHP is required for PHAR installation (or pass --static)" "error"
    exit 1
  fi
  if [[ "1" != "$(php -r "echo version_compare(PHP_VERSION, '${REQUIRED_PHP_VERSION}', '>=') ? '1' : '0';")" ]]; then
    output "  [ ] ERROR: PHP >= ${REQUIRED_PHP_VERSION} required (found $(php -r 'echo PHP_VERSION;'))" "error"
    exit 1
  fi
  output "  [*] PHP version: $(php -r 'echo PHP_VERSION;')" "success"
  missing=()
  for ext in "${REQUIRED_EXTENSIONS[@]}"; do
    if [[ "1" != "$(php -r "echo extension_loaded('${ext}') ? '1' : '0';")" ]]; then
      missing+=("${ext}")
    fi
  done
  if ((${#missing[@]} > 0)); then
    output "  [ ] ERROR: missing PHP extensions: ${missing[*]}" "error"
    exit 1
  fi
  output "  [*] Required PHP extensions present" "success"
fi

kernel="$(uname -s 2>/dev/null || /usr/bin/uname -s)"
case "${kernel}" in
  Linux|linux) kernel="linux" ;;
  Darwin|darwin) kernel="darwin" ;;
  *) output "OS '${kernel}' not supported" "error"; exit 1 ;;
esac

machine="$(uname -m 2>/dev/null || /usr/bin/uname -m)"
case "${machine}" in
  aarch64*|armv8*|arm64) machine="arm64" ;;
  x86_64|amd64) machine="amd64" ;;
  *) output "Architecture (${machine}) is not supported" "error"; exit 1 ;;
esac
platform="${kernel}-${machine}"
output "  [*] Platform ${platform}" "success"

if [[ "${static}" == "true" ]]; then
  asset="hatfield.${platform}"
  cli_asset="hatfield.${platform}.php"
else
  # Canonical PHAR is platform-neutral (same file for Linux/macOS/Windows with PHP).
  asset="hatfield.phar"
  cli_asset=""
fi
sums_asset="SHA256SUMS"

if [[ -n "${INSTALLER_BASE_URL}" ]]; then
  base="${INSTALLER_BASE_URL%/}"
  download_url="${base}/${asset}"
  sums_url="${base}/${sums_asset}"
  cli_download_url=""
  if [[ -n "${cli_asset}" ]]; then
    cli_download_url="${base}/${cli_asset}"
  fi
else
  if [[ "${version}" == "latest" ]]; then
    version_path="latest/download"
  else
    version_path="download/${version}"
  fi
  download_url="${DOWNLOAD_BASE}/${version_path}/${asset}"
  sums_url="${DOWNLOAD_BASE}/${version_path}/${sums_asset}"
  cli_download_url=""
  if [[ -n "${cli_asset}" ]]; then
    cli_download_url="${DOWNLOAD_BASE}/${version_path}/${cli_asset}"
  fi
fi

output "\nDownload" "heading"
output "  Asset: ${asset}"
output "  URL:   ${download_url}"
if [[ -n "${cli_asset}" ]]; then
  output "  CLI:   ${cli_asset}"
  output "  URL:   ${cli_download_url}"
fi

tmp_bin="${TMPDIR_INSTALL}/${asset}"
tmp_sums="${TMPDIR_INSTALL}/${sums_asset}"
tmp_cli=""
if [[ -n "${cli_asset}" ]]; then
  tmp_cli="${TMPDIR_INSTALL}/${cli_asset}"
fi

download() {
  local url="$1" dest="$2"
  local http_code=""
  case "${downloader}" in
    curl)
      http_code="$(curl -sS -L -o "${dest}" -w "%{http_code}" "${url}")" || true
      ;;
    wget)
      if wget -q -O "${dest}" "${url}"; then
        http_code="200"
      else
        http_code="000"
      fi
      ;;
  esac
  if [[ "${http_code}" != "200" ]]; then
    output "  Download failed for ${url} (http_code=${http_code})" "error"
    exit 1
  fi
  if [[ ! -s "${dest}" ]]; then
    output "  Downloaded empty file from ${url}" "error"
    exit 1
  fi
}

download "${download_url}" "${tmp_bin}"
download "${sums_url}" "${tmp_sums}"
if [[ -n "${tmp_cli}" ]]; then
  download "${cli_download_url}" "${tmp_cli}"
fi
output "  [*] Downloaded asset${tmp_cli:+, owned PHP CLI,} and SHA256SUMS" "success"

output "\nVerify" "heading"
# Exact filename match only — do not accept partial path collisions.
verify_sha256() {
  local path="$1"
  local name="$2"
  local expected_line expected_hash actual_hash
  expected_line="$(grep -E "^[a-f0-9]{64}  ${name}\$" "${tmp_sums}" || true)"
  if [[ -z "${expected_line}" ]]; then
    output "  [ ] ERROR: ${name} not found as an exact entry in SHA256SUMS" "error"
    exit 1
  fi
  expected_hash="${expected_line%% *}"
  if command -v sha256sum >/dev/null 2>&1; then
    actual_hash="$(sha256sum "${path}" | awk '{print $1}')"
  elif command -v shasum >/dev/null 2>&1; then
    actual_hash="$(shasum -a 256 "${path}" | awk '{print $1}')"
  else
    output "  [ ] ERROR: sha256sum or shasum is required" "error"
    exit 1
  fi
  if [[ "${actual_hash}" != "${expected_hash}" ]]; then
    output "  [ ] ERROR: checksum mismatch for ${name}" "error"
    output "      expected ${expected_hash}" "error"
    output "      actual   ${actual_hash}" "error"
    exit 1
  fi
  output "  [*] SHA-256 verified: ${name}" "success"
}

verify_sha256 "${tmp_bin}" "${asset}"
if [[ -n "${tmp_cli}" ]]; then
  verify_sha256 "${tmp_cli}" "${cli_asset}"
fi

# Run --version against a candidate path (PHAR via host php, static direct).
# On failure: print fail-closed message and return 1 so previous install is untouched.
# Must be called in the main shell (not $(...)) so diagnostics stay on stdout.
# $2 = command-failure message; $3 = missing-Hatfield message (exact prior wording).
# Sets SMOKE_OUT on success.
#
# Disposable isolation under TMPDIR_INSTALL:
#   - HATFIELD_CACHE_DIR / HATFIELD_LOG_DIR under the install temp tree so
#     Symfony container compilation never seeds the caller's project cache
#     or the persistent XDG Hatfield cache.
#   - HOME under the install temp tree so user settings cannot leak into smoke.
#   - CWD is a throwaway directory under TMPDIR_INSTALL for the same reason.
#   - Static smokes require an adjacent hatfield-php helper beside the app path.
# Cleanup trap removes TMPDIR_INSTALL (and therefore these smoke roots).
version_smoke() {
  local path="$1"
  local fail_cmd="$2"
  local fail_content="$3"
  local helper_path="${4:-}"
  local out=""
  local smoke_root=""
  local smoke_cache=""
  local smoke_log=""
  local smoke_home=""
  local smoke_cwd=""
  local smoke_bin=""
  local smoke_helper=""
  SMOKE_OUT=""

  if [[ -z "${TMPDIR_INSTALL}" || ! -d "${TMPDIR_INSTALL}" ]]; then
    output "  [ ] ERROR: installer temporary directory is missing; cannot isolate smoke" "error"
    return 1
  fi

  smoke_root="$(mktemp -d "${TMPDIR_INSTALL}/smoke.XXXXXX")"
  smoke_cache="${smoke_root}/cache"
  smoke_log="${smoke_root}/logs"
  smoke_home="${smoke_root}/home"
  smoke_cwd="${smoke_root}/cwd"
  mkdir -p "${smoke_cache}" "${smoke_log}" "${smoke_home}" "${smoke_cwd}"

  if [[ "${static}" == "true" ]]; then
    if [[ -z "${helper_path}" || ! -x "${helper_path}" ]]; then
      output "  [ ] ERROR: static candidate smoke requires adjacent owned PHP CLI" "error"
      return 1
    fi
    # Stage a disposable adjacent pair so bootstrap can resolve hatfield-php
    # without requiring install_dir on PATH or mutating the candidate download.
    smoke_bin="${smoke_cwd}/${HATFIELD_EXECUTABLE}"
    smoke_helper="${smoke_cwd}/${HATFIELD_OWNED_PHP_CLI}"
    cp "${path}" "${smoke_bin}"
    cp "${helper_path}" "${smoke_helper}"
    chmod +x "${smoke_bin}" "${smoke_helper}"
    out="$(cd "${smoke_cwd}" && HOME="${smoke_home}" HATFIELD_CACHE_DIR="${smoke_cache}" HATFIELD_LOG_DIR="${smoke_log}" "./${HATFIELD_EXECUTABLE}" --version 2>&1)" || {
      output "${fail_cmd}" "error"
      return 1
    }
  else
    out="$(cd "${smoke_cwd}" && HOME="${smoke_home}" HATFIELD_CACHE_DIR="${smoke_cache}" HATFIELD_LOG_DIR="${smoke_log}" php "${path}" --version 2>&1)" || {
      output "${fail_cmd}" "error"
      return 1
    }
  fi
  if [[ "${out}" != *"Hatfield"* ]]; then
    output "${fail_content}" "error"
    if [[ "${fail_content}" == *"did not report Hatfield"* ]]; then
      output "      output: ${out}" "error"
    fi
    return 1
  fi
  if [[ "${static}" == "true" ]]; then
    # Owned CLI must be a real executable interpreter, not another Hatfield app.
    if ! "${helper_path}" -r 'echo ok;' >/dev/null 2>&1; then
      output "  [ ] ERROR: owned PHP CLI smoke failed; previous install left unchanged" "error"
      return 1
    fi
  fi
  SMOKE_OUT="${out}"
  return 0
}

# Candidate smoke BEFORE replacing any existing install.
output "\nCandidate smoke" "heading"
chmod +x "${tmp_bin}"
if [[ "${static}" == "true" ]]; then
  chmod +x "${tmp_cli}"
  if ! version_smoke "${tmp_bin}" \
    "  [ ] ERROR: candidate --version smoke failed; previous install left unchanged" \
    "  [ ] ERROR: candidate --version did not report Hatfield; previous install left unchanged" \
    "${tmp_cli}"; then
    exit 1
  fi
else
  if ! version_smoke "${tmp_bin}" \
    "  [ ] ERROR: candidate --version smoke failed; previous install left unchanged" \
    "  [ ] ERROR: candidate --version did not report Hatfield; previous install left unchanged"; then
    exit 1
  fi
fi
output "  [*] Candidate smoke ok: ${SMOKE_OUT}" "success"

output "\nInstall" "heading"
mkdir -p "${install_dir}"
dest="${install_dir}/${HATFIELD_EXECUTABLE}"
cli_dest="${install_dir}/${HATFIELD_OWNED_PHP_CLI}"

if [[ "${static}" == "true" ]]; then
  # Stage a matched pair under a private install-dir temp, smoke it, then swap
  # both destinations. Any failure before both final moves restores the previous
  # pair via the EXIT trap.
  INSTALL_PAIR_DIR="${install_dir}/.hatfield-install-pair.$$"
  mkdir -p "${INSTALL_PAIR_DIR}"
  INSTALL_TMP="${INSTALL_PAIR_DIR}/${HATFIELD_EXECUTABLE}"
  INSTALL_CLI_TMP="${INSTALL_PAIR_DIR}/${HATFIELD_OWNED_PHP_CLI}"
  cp "${tmp_bin}" "${INSTALL_TMP}"
  cp "${tmp_cli}" "${INSTALL_CLI_TMP}"
  chmod +x "${INSTALL_TMP}" "${INSTALL_CLI_TMP}"
  if ! version_smoke "${INSTALL_TMP}" \
    "  [ ] ERROR: install-dir temp --version failed; previous install left unchanged" \
    "  [ ] ERROR: install-dir temp --version invalid; previous install left unchanged" \
    "${INSTALL_CLI_TMP}"; then
    exit 1
  fi
  output "Installing matched pair to ${dest} and ${cli_dest}..."
  if [[ -e "${dest}" ]]; then
    INSTALL_APP_BAK="${INSTALL_PAIR_DIR}/previous-${HATFIELD_EXECUTABLE}"
    mv -f "${dest}" "${INSTALL_APP_BAK}"
  fi
  if [[ -e "${cli_dest}" ]]; then
    INSTALL_CLI_BAK="${INSTALL_PAIR_DIR}/previous-${HATFIELD_OWNED_PHP_CLI}"
    mv -f "${cli_dest}" "${INSTALL_CLI_BAK}"
  fi
  mv -f "${INSTALL_TMP}" "${dest}"
  mv -f "${INSTALL_CLI_TMP}" "${cli_dest}"
  INSTALL_TMP=""
  INSTALL_CLI_TMP=""
  INSTALL_APP_BAK=""
  INSTALL_CLI_BAK=""
  rm -rf "${INSTALL_PAIR_DIR}"
  INSTALL_PAIR_DIR=""
else
  # PHAR-only: atomic single-file replace; owned CLI is not installed.
  INSTALL_TMP="${install_dir}/.hatfield-install.$$"
  cp "${tmp_bin}" "${INSTALL_TMP}"
  chmod +x "${INSTALL_TMP}"
  if ! version_smoke "${INSTALL_TMP}" \
    "  [ ] ERROR: install-dir temp --version failed; previous install left unchanged" \
    "  [ ] ERROR: install-dir temp --version invalid; previous install left unchanged"; then
    exit 1
  fi
  output "Installing to ${dest}..."
  mv -f "${INSTALL_TMP}" "${dest}"
  INSTALL_TMP=""
fi
